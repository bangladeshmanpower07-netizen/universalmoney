<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>BMA - Secure Digital Payment Platform</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
<style>
  :root{
    --bma-primary:#4F46E5;
    --bma-success:#10B981;
    --bma-danger:#EF4444;
    --bma-warning:#F59E0B;
    --bma-dark:#111827;
    --bma-bg:#F4F7FE;
  }
  *{font-family:'Inter',sans-serif;}
  body{
    background:linear-gradient(135deg,var(--bma-bg) 0%,#EEF1FF 100%);
    min-height:100vh;
    display:flex;
    align-items:center;
    justify-content:center;
    padding:24px;
  }
  .auth-card{
    width:100%;
    max-width:420px;
    background:#fff;
    border-radius:18px;
    box-shadow:0 20px 50px rgba(17,24,39,0.08);
    padding:40px 36px;
  }
  .brand-logo{
    width:56px;height:56px;border-radius:16px;
    background:linear-gradient(135deg,var(--bma-primary),#7C3AED);
    display:flex;align-items:center;justify-content:center;
    color:#fff;font-size:26px;font-weight:800;margin:0 auto 18px;
  }
  h1.title{font-weight:800;font-size:26px;color:var(--bma-dark);text-align:center;margin-bottom:4px;}
  p.subtitle{color:#6B7280;text-align:center;font-size:14px;margin-bottom:28px;}
  .form-label{font-weight:600;font-size:13px;color:var(--bma-dark);}
  .form-control{
    border-radius:12px;padding:11px 14px;border:1px solid #E5E7EB;font-size:14.5px;
  }
  .form-control:focus{border-color:var(--bma-primary);box-shadow:0 0 0 3px rgba(79,70,229,0.12);}
  .btn-bma{
    background:var(--bma-primary);border:none;border-radius:12px;padding:12px;
    font-weight:700;font-size:15px;color:#fff;width:100%;
  }
  .btn-bma:hover{background:#4338CA;color:#fff;}
  .link-muted{color:#6B7280;font-size:13.5px;text-decoration:none;}
  .link-muted:hover{color:var(--bma-primary);}
  .alert-mini{border-radius:12px;font-size:13.5px;}
  .divider-tab{
    display:flex;background:#F3F4F6;border-radius:12px;padding:4px;margin-bottom:22px;
  }
  .divider-tab button{
    flex:1;border:none;background:transparent;padding:9px;border-radius:9px;font-weight:600;font-size:13.5px;color:#6B7280;
  }
  .divider-tab button.active{background:#fff;color:var(--bma-primary);box-shadow:0 1px 4px rgba(0,0,0,0.08);}
  .tab-pane-manual{display:none;}
  .tab-pane-manual.show{display:block;}
  .input-icon{position:relative;}
  .input-icon i{position:absolute;left:14px;top:50%;transform:translateY(-50%);color:#9CA3AF;font-size:13px;}
  .input-icon input{padding-left:38px;}
  .footer-note{text-align:center;margin-top:22px;font-size:12px;color:#9CA3AF;}
</style>
</head>
<body>
<div class="auth-card">
  <div class="brand-logo">B</div>
  <h1 class="title">Welcome Back</h1>
  <p class="subtitle">Secure Digital Payment Platform</p>

  <% if (typeof error !== 'undefined' && error) { %>
    <div class="alert alert-danger alert-mini py-2 px-3 mb-3"><i class="fa-solid fa-circle-exclamation me-1"></i> <%= error %></div>
  <% } %>
  <% if (typeof notice !== 'undefined' && notice) { %>
    <div class="alert alert-success alert-mini py-2 px-3 mb-3"><i class="fa-solid fa-circle-check me-1"></i> <%= notice %></div>
  <% } %>

  <div class="divider-tab">
    <button type="button" class="active" onclick="showPane('login', this)">Sign In</button>
    <button type="button" onclick="showPane('register', this)">Create Account</button>
    <button type="button" onclick="showPane('forgot', this)">Forgot Password</button>
  </div>

  <div id="pane-login" class="tab-pane-manual show">
    <form method="POST" action="/login" autocomplete="off">
      <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
      <div class="mb-3">
        <label class="form-label">Email or Phone</label>
        <div class="input-icon">
          <i class="fa-regular fa-envelope"></i>
          <input type="text" name="identifier" class="form-control" placeholder="you@example.com" required maxlength="120">
        </div>
      </div>
      <div class="mb-3">
        <label class="form-label">Password</label>
        <div class="input-icon">
          <i class="fa-solid fa-lock"></i>
          <input type="password" name="password" class="form-control" placeholder="••••••••" required maxlength="128">
        </div>
      </div>
      <button type="submit" class="btn btn-bma mt-2"><i class="fa-solid fa-right-to-bracket me-1"></i> Sign In</button>
    </form>
  </div>

  <div id="pane-register" class="tab-pane-manual">
    <form method="POST" action="/register" autocomplete="off">
      <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
      <div class="mb-3">
        <label class="form-label">Full Name</label>
        <input type="text" name="full_name" class="form-control" required maxlength="120">
      </div>
      <div class="mb-3">
        <label class="form-label">Email</label>
        <input type="email" name="email" class="form-control" required maxlength="120">
      </div>
      <div class="mb-3">
        <label class="form-label">Phone</label>
        <input type="text" name="phone" class="form-control" required maxlength="32">
      </div>
      <div class="mb-3">
        <label class="form-label">Password</label>
        <input type="password" name="password" class="form-control" required minlength="8" maxlength="128">
      </div>
      <div class="mb-3">
        <label class="form-label">Account Type</label>
        <select name="role" class="form-control form-select">
          <option value="user">Personal (User)</option>
          <option value="merchant">Business (Merchant)</option>
        </select>
      </div>
      <button type="submit" class="btn btn-bma mt-2"><i class="fa-solid fa-user-plus me-1"></i> Create Account</button>
    </form>
  </div>

  <div id="pane-forgot" class="tab-pane-manual">
    <form method="POST" action="/forgot-password" autocomplete="off">
      <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
      <p class="text-muted small mb-3">Enter your account email. If it matches an account, we will send reset instructions.</p>
      <div class="mb-3">
        <label class="form-label">Email</label>
        <input type="email" name="email" class="form-control" required maxlength="120">
      </div>
      <button type="submit" class="btn btn-bma mt-2"><i class="fa-solid fa-paper-plane me-1"></i> Send Reset Link</button>
    </form>
  </div>

  <div class="footer-note">
    &copy; <%= new Date().getFullYear() %> BMA Digital Payments &middot; 1 BMC = <%= typeof coinRate !== 'undefined' ? coinRate : 16 %> BDT
  </div>
</div>
<script>
function showPane(name, btn){
  document.querySelectorAll('.tab-pane-manual').forEach(p=>p.classList.remove('show'));
  document.getElementById('pane-'+name).classList.add('show');
  document.querySelectorAll('.divider-tab button').forEach(b=>b.classList.remove('active'));
  btn.classList.add('active');
}
</script>
</body>
</html>
